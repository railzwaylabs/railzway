
# App Config
APP_NAME=billing

# e.g development, production
APP_ENV=development
PORT=8080

# disabled, direct, proxy
APP_TLS_MODE=disabled
APP_TLS_CERT_FILE=
APP_TLS_KEY_FILE=
CSP_EXTRA_DIRECTIVES=

# OpenTelemetry Tracing
# Leave OTLP endpoint empty to keep tracing disabled.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=railzway
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=10s
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Profiling (Grafana Pyroscope)
# Leave empty to use local pprof, or set address to push continuous profile metrics
PYROSCOPE_SERVER_ADDRESS=

# Summary Refresh
SUMMARY_CONCURRENCY=4
SUMMARY_TIMEOUT_MS=2000
SUMMARY_REFRESH_INTERVAL_SEC=60

# Subscription Close Period Scheduler
SUBSCRIPTION_CLOSE_PERIOD_INTERVAL_SEC=60
SUBSCRIPTION_CLOSE_PERIOD_BATCH_SIZE=200

# Rating Scheduler
RATING_JOB_INTERVAL_SEC=30
RATING_JOB_BATCH_SIZE=200
LATE_USAGE_GRACE_HOURS=0

# Reconciliation Scheduler
RECONCILIATION_JOB_INTERVAL_SEC=21600
RECONCILIATION_WINDOW_DAYS=7
RECONCILIATION_INVOICE_LIMIT=200

# Public API Rate Limits (per minute)
RATE_LIMIT_USAGE_EVENTS_WINDOW_SEC=60
RATE_LIMIT_USAGE_EVENTS_SUBSCRIPTION_PER_MIN=120
RATE_LIMIT_USAGE_EVENTS_CUSTOMER_PER_MIN=600
RATE_LIMIT_USAGE_EVENTS_ORG_PER_MIN=3000
RATE_LIMIT_USAGE_EVENTS_CONCURRENCY_PER_CUSTOMER_METER=1
RATE_LIMIT_USAGE_EVENTS_CONCURRENCY_TTL_SEC=5

# Apps
APPS_CREDENTIALS_KEY=<REPLACE_ME_BASE64_32_BYTES>
STRIPE_CONNECT_CLIENT_ID=<REPLACE_ME>
STRIPE_CONNECT_SECRET=<REPLACE_ME>
# e.g http://localhost:8080/admin/v1/apps/oauth/stripe/callback
STRIPE_CONNECT_REDIRECT_URL=<REPLACE_ME>


# Database
# e.g postgres, mysql, sqlite
DB_TYPE=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_HOST=localhost
DB_NAME=postgres
DB_SSL_MODE=disable
DB_TIMEZONE=UTC

# Database Pooling
DB_MAX_IDLE_CONN=10
DB_MAX_OPEN_CONN=50
# seconds
DB_CONN_MAX_LIFETIME=300
DB_CONN_MAX_IDLE_TIME=60

# Bootstrap
ENSURE_DEFAULT_ORG_AND_USER=true
RAILZWAY_ORG_NAME=<REPLACE_ME>
RAILZWAY_USER_EMAIL=<REPLACE_ME>
RAILZWAY_USER_PASSWORD=<REPLACE_ME>

# Admin Auth
SESSION_TTL_HOURS=24
SESSION_SECRET=<REPLACE_ME>
SESSION_COOKIE_NAME=rz_admin_session

# Redis
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_URL=
REDIS_DB=1

# Cache
CACHE_USERNAME=
CACHE_PASSWORD=
CACHE_URL=
CACHE_DB=3

# Misc
SMTP_FROM_EMAIL=<REPLACE_ME>

# Public Links
PUBLIC_LINK_SECRET=change-me
PUBLIC_LINK_TTL_HOURS=168
PUBLIC_LINK_BASE_URL=http://localhost:8080
